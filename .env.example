# Copy to .env and fill in real values. .env is gitignored — never commit it.

NODE_ENV=development
PORT=3000

# The Astro frontend's origin — used for CORS in production and to build
# links (email verification, password reset) that point back at the site.
FRONTEND_URL="http://localhost:4321"

# Matches docker-compose.yml's postgres service. If you're using
# `npx prisma dev` for local development instead, use the connection string
# it prints when started.
DATABASE_URL="postgresql://conference_contact:local_dev_only@localhost:5432/conference_contact?schema=public"

# Backs BullMQ (email + Stripe webhook processing queues) and the short-TTL
# access-token revocation list admin suspension writes to. Any real Redis
# works locally (Docker/Homebrew); see README's Local setup section.
REDIS_URL="redis://localhost:6379"

# Access tokens are short-lived JWTs signed with this secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_DAYS=30

# AES-256-GCM key for encrypting 2FA secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_ENCRYPTION_KEY=

# Get from resend.com. RESEND_FROM_EMAIL must be on a domain verified in the
# Resend dashboard for production — the resend.dev address below only works
# for testing.
RESEND_API_KEY=
RESEND_FROM_EMAIL="conference.contact <onboarding@resend.dev>"
# Where /contact form submissions are delivered. Must be an address Resend
# is actually allowed to send to (your own verified email in sandbox mode,
# or any address once a real domain is verified).
SUPPORT_EMAIL=

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_TRUSTED_DEVICES=3
RISK_HIGH_THRESHOLD=50

# From the Stripe dashboard, TEST MODE keys (sk_test_..., whsec_...) —
# never put a live key in a local .env. STRIPE_WEBHOOK_SECRET comes from
# either a dashboard webhook endpoint or `stripe listen` if you have the
# Stripe CLI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# How long a PAST_DUE subscription keeps product access before being
# treated as if it had no subscription at all.
PAYMENT_GRACE_PERIOD_DAYS=7

# From console.anthropic.com. Powers Lead Finder's natural-language query
# parsing (ClaudeService).
ANTHROPIC_API_KEY=

# From apollo.io — Settings > API, scoped to at least
# mixed_people/api_search and people/match. Powers Lead Finder's live
# web search + enrichment (ApolloService).
APOLLO_API_KEY=
# Cap on candidates enriched per single search — each one spends a real
# Apollo credit.
LEAD_SEARCH_MAX_RESULTS=25
